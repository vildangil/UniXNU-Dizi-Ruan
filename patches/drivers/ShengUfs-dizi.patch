+#if !defined(NATIVE_VERIFIED_BLOCK) || !NATIVE_VERIFIED_BLOCK
+// dizi bring-up stand-ins for the two verified-block queries of XNU's owner SystemOS mount
+// (kern_exec.c native_owner_cache_prepare). With native-ufs-allow-unverified=1 a device counts as
+// authorized when its IOMedia sits on a UFS root window; nothing is authenticated. Without the
+// boot-arg both answer "no", so the mount refuses as in a build that has no verified storage.
+static bool ufsMediaOnWindow (IORegistryEntry *media)
+{
+  for (IORegistryEntry *entry = media; entry; entry = entry->getParentEntry (gIOServicePlane)) {
+    if (OSDynamicCast (NativeUfsBlock, entry)) return true;
+  }
+  return false;
+}
+
+static bool ufsMediaDevice (IORegistryEntry *media, dev_t *device, OSString **name)
+{
+  OSString *bsd = OSDynamicCast (OSString, media->getProperty (kIOBSDNameKey));
+  OSNumber *mjr = OSDynamicCast (OSNumber, media->getProperty (kIOBSDMajorKey));
+  OSNumber *mnr = OSDynamicCast (OSNumber, media->getProperty (kIOBSDMinorKey));
+  if (!bsd || !mjr || !mnr || !bsd->getLength () || mjr->unsigned64BitValue () > 255 ||
+      mnr->unsigned64BitValue () > 0xffffff) return false;
+  *device = static_cast<dev_t> (makedev (mjr->unsigned32BitValue (), mnr->unsigned32BitValue ()));
+  if (name) *name = bsd;
+  return true;
+}
+
+extern "C" int native_verified_block_root_authorized (dev_t device)
+{
+  if (!gAllowUnverifiedRoot || device == NODEV) return 0;
+  OSDictionary *matching = IOService::serviceMatching ("IOMedia");
+  OSIterator *iterator = matching ? IOService::getMatchingServices (matching) : nullptr;
+  OSSafeReleaseNULL (matching);
+  if (!iterator) return 0;
+  int found = 0;
+  while (OSObject *object = iterator->getNextObject ()) {
+    IORegistryEntry *media = OSDynamicCast (IORegistryEntry, object);
+    dev_t candidate = NODEV;
+    if (media && ufsMediaDevice (media, &candidate, nullptr) && candidate == device) {
+      found = ufsMediaOnWindow (media) ? 1 : 0;
+      break;
+    }
+  }
+  iterator->release ();
+  return found;
+}
+
+// Not a manifest digest: SHA-384 over a fixed tag and the volume UUID, only so that XNU can publish a
+// stable /chosen boot-manifest-hash (mount(8) requires one). Answered only for a UFS window volume whose
+// UUID matches.
+extern "C" int native_verified_block_manifest_sha384 (dev_t device, const char *uuid, uint8_t digest[48])
+{
+  static const char tag[] = "UniXNU.dizi.unverified-volume.v1";
+  if (!digest) return 0;
+  bzero (digest, 48);
+  if (!gAllowUnverifiedRoot || !uuid || strlen (uuid) != 36 || device == NODEV) return 0;
+  OSDictionary *matching = IOService::serviceMatching ("IOMedia");
+  OSIterator *iterator = matching ? IOService::getMatchingServices (matching) : nullptr;
+  OSSafeReleaseNULL (matching);
+  if (!iterator) return 0;
+  bool found = false;
+  while (OSObject *object = iterator->getNextObject ()) {
+    IORegistryEntry *media = OSDynamicCast (IORegistryEntry, object);
+    dev_t candidate = NODEV;
+    if (!media || !ufsMediaDevice (media, &candidate, nullptr) || candidate != device) continue;
+    OSString *identity = OSDynamicCast (OSString, media->getProperty ("UUID"));
+    found = identity && !strcmp (identity->getCStringNoCopy (), uuid) && ufsMediaOnWindow (media);
+    break;
+  }
+  iterator->release ();
+  if (!found) return 0;
+  SHA384_CTX context;
+  SHA384_Init (&context);
+  SHA384_Update (&context, tag, sizeof (tag));
+  SHA384_Update (&context, uuid, 36);
+  SHA384_Final (digest, &context);
+  return 1;
+}
+
+extern "C" int native_verified_block_volume_device (const char *uuid, dev_t *device, char *path, size_t size)
+{
+  if (!uuid || !device || !path || size < 6 || strlen (uuid) != 36) return 0;
+  *device = NODEV;
+  path[0] = 0;
+  if (!gAllowUnverifiedRoot) return 0;
+  OSDictionary *matching = IOService::serviceMatching ("IOMedia");
+  OSDictionary *properties = OSDictionary::withCapacity (1);
+  OSString *wanted = OSString::withCString (uuid);
+  bool ready = matching && properties && wanted && properties->setObject ("UUID", wanted) &&
+               matching->setObject ("IOPropertyMatch", properties);
+  OSSafeReleaseNULL (wanted);
+  OSSafeReleaseNULL (properties);
+  OSIterator *iterator = ready ? IOService::getMatchingServices (matching) : nullptr;
+  OSSafeReleaseNULL (matching);
+  if (!iterator) return 0;
+  unsigned matches = 0;
+  dev_t candidate = NODEV;
+  char candidatePath[64] = {};
+  while (OSObject *object = iterator->getNextObject ()) {
+    IORegistryEntry *media = OSDynamicCast (IORegistryEntry, object);
+    OSString *name = nullptr;
+    if (!media || ++matches != 1) continue;
+    if (!ufsMediaOnWindow (media) || !ufsMediaDevice (media, &candidate, &name) ||
+        name->getLength () >= sizeof (candidatePath) - 6 || name->getLength () >= size - 6) {
+      candidate = NODEV;
+      continue;
+    }
+    snprintf (candidatePath, sizeof (candidatePath), "/dev/%s", name->getCStringNoCopy ());
+  }
+  iterator->release ();
+  if (matches != 1 || candidate == NODEV) return 0;
+  *device = candidate;
+  strlcpy (path, candidatePath, size);
+  IOLog ("NativeUfs: unverified volume %s at %s\n", uuid, candidatePath);
+  return 1;
+}
+#endif
