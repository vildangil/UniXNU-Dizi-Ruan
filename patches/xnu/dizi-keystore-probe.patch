+	/* dizi: the AppleKeyStore stand-in (package/KeyStoreProbe.cpp, UniXNU component AppleKeyStoreState, from the ruan port) for
+	 * keybagd, init_data_protection and usermanagerd on a board without SEP, before launchd. It starts only with aks=1 and
+	 * offline-key-events=1; stage 3 status 0 on the boot-progress page means the service is published. */
+	{
+		extern void native_keystore_probe(void);
