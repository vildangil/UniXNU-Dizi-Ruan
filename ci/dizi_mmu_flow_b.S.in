.section .text.trace,"ax",%progbits
.p2align 2
.global trace_hit_1
trace_hit_1:
    stp x12,x13,[sp,#-16]!
    adr x12,trace_resume_1
    movz w13,#1
    b trace_common
trace_resume_1:
    ldp x12,x13,[sp],#16
    .inst 0xaa0003f3
    nop
.global trace_hit_2
trace_hit_2:
    stp x12,x13,[sp,#-16]!
    adr x12,trace_resume_2
    movz w13,#2
    b trace_common
trace_resume_2:
    ldp x12,x13,[sp],#16
    .inst 0x91000108
    nop
.global trace_hit_3
trace_hit_3:
    stp x12,x13,[sp,#-16]!
    adr x12,trace_resume_3
    movz w13,#3
    b trace_common
trace_resume_3:
    ldp x12,x13,[sp],#16
    .inst 0xaa1403e0
    nop
.global trace_hit_4
trace_hit_4:
    stp x12,x13,[sp,#-16]!
    adr x12,trace_resume_4
    movz w13,#4
    b trace_common
trace_resume_4:
    ldp x12,x13,[sp],#16
    .inst 0xaa1303e0
    nop
.global trace_hit_5
trace_hit_5:
    stp x12,x13,[sp,#-16]!
    adr x12,trace_resume_5
    movz w13,#5
    b trace_common
trace_resume_5:
    ldp x12,x13,[sp],#16
    .inst 0xaa1403e1
    nop
.global trace_hit_6
trace_hit_6:
    stp x12,x13,[sp,#-16]!
    adr x12,trace_resume_6
    movz w13,#6
    b trace_common
trace_resume_6:
    ldp x12,x13,[sp],#16
    .inst 0x52800020
    nop
.global trace_hit_7
trace_hit_7:
    stp x12,x13,[sp,#-16]!
    adr x12,trace_resume_7
    movz w13,#7
    b trace_common
trace_resume_7:
    ldp x12,x13,[sp],#16
    .inst 0x79000268
    nop
.global trace_hit_8
trace_hit_8:
    stp x12,x13,[sp,#-16]!
    adr x12,trace_resume_8
    movz w13,#8
    b trace_common
trace_resume_8:
    ldp x12,x13,[sp],#16
    .inst 0xaa0003f4
    nop
trace_common:
    sub sp,sp,#0xb0
    stp x0,x1,[sp,#0]
    stp x2,x3,[sp,#16]
    stp x4,x5,[sp,#32]
    stp x6,x7,[sp,#48]
    stp x8,x9,[sp,#64]
    stp x10,x11,[sp,#80]
    stp x12,x13,[sp,#96]
    stp x14,x15,[sp,#112]
    stp x16,x17,[sp,#128]
    stp x18,x30,[sp,#144]
    mrs x9,NZCV
    str x9,[sp,#160]
    mov w0,w13
    bl trace_render
    ldr x9,[sp,#160]
    msr NZCV,x9
    ldp x0,x1,[sp,#0]
    ldp x2,x3,[sp,#16]
    ldp x4,x5,[sp,#32]
    ldp x6,x7,[sp,#48]
    ldp x8,x9,[sp,#64]
    ldp x10,x11,[sp,#80]
    ldp x12,x13,[sp,#96]
    ldp x14,x15,[sp,#112]
    ldp x16,x17,[sp,#128]
    ldp x18,x30,[sp,#144]
    add sp,sp,#0xb0
    br x12
trace_render:
    // First 2MiB only: fb high alias + 650*4 + 6400*(10+34*stage)
    movz x9,#0
    movk x9,#0x0400,lsl#16
    movk x9,#0xfff0,lsl#32
    movk x9,#0xffff,lsl#48
    movz x10,#2600
    add x9,x9,x10
    movz x1,#34
    mul x1,x0,x1
    add x1,x1,#10
    movz x3,#6400
    madd x7,x1,x3,x9
    cmp w0,#1
    b.eq trace_msg_1
    cmp w0,#2
    b.eq trace_msg_2
    cmp w0,#3
    b.eq trace_msg_3
    cmp w0,#4
    b.eq trace_msg_4
    cmp w0,#5
    b.eq trace_msg_5
    cmp w0,#6
    b.eq trace_msg_6
    cmp w0,#7
    b.eq trace_msg_7
    cmp w0,#8
    b.eq trace_msg_8
    ret
trace_msg_1:
    adr x15,msg_1
    b trace_draw
trace_msg_2:
    adr x15,msg_2
    b trace_draw
trace_msg_3:
    adr x15,msg_3
    b trace_draw
trace_msg_4:
    adr x15,msg_4
    b trace_draw
trace_msg_5:
    adr x15,msg_5
    b trace_draw
trace_msg_6:
    adr x15,msg_6
    b trace_draw
trace_msg_7:
    adr x15,msg_7
    b trace_draw
trace_msg_8:
    adr x15,msg_8
    b trace_draw
trace_draw:
    movz w10,#0xf0ff
    movk w10,#0xffe6,lsl#16
    adr x17,font5_table
trace_char:
    ldrb w8,[x15],#1
    cbz w8,trace_done
    sub w8,w8,#32
    lsl x5,x8,#3
    sub x5,x5,x8
    add x5,x17,x5
    mov x2,x7
    movz x4,#7
trace_glyph_row:
    ldrb w11,[x5],#1
    mov x14,x2
    movz x6,#5
trace_glyph_bit:
    tbz w11,#4,trace_blank
    mov x9,x14
    movz x8,#4
trace_pixel_row:
    stp w10,w10,[x9]
    stp w10,w10,[x9,#8]
    add x9,x9,x3
    sub x8,x8,#1
    cbnz x8,trace_pixel_row
trace_blank:
    add x14,x14,#16
    lsl w11,w11,#1
    sub x6,x6,#1
    cbnz x6,trace_glyph_bit
    add x2,x2,x3,lsl#2
    sub x4,x4,#1
    cbnz x4,trace_glyph_row
    add x7,x7,#96
    b trace_char
trace_done:
    dsb sy
    ret
.p2align 2
font5_table:
    FONT_DATA
.p2align 2
msg_1: .asciz "1 PROLOGUE"
msg_2: .asciz "2 TBI RETURN"
msg_3: .asciz "3 KC REBASE"
msg_4: .asciz "4 CPU DATA"
msg_5: .asciz "5 PE PLATFORM"
msg_6: .asciz "6 TIMER WFE"
msg_7: .asciz "7 CPU TOPO"
msg_8: .asciz "8 THREAD READY"
