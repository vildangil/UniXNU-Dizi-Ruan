/dts-v1/;
/include/ "sm7435.dtsi"

/ {
    model = "Xiaomi Redmi Pad Pro (dizi)";
    compatible = "xiaomi,dizi", "qcom,sm7435";

    // SMP topology, PSCI, architectural timer and GICv3 are provided by
    // the version-pinned SM7435 SoC DTSI. Dizi-specific DDR reservations,
    // graphics/storage resources and secure carveouts remain unverified.
    // This DTS intentionally does not publish an unverified XNU RAM pool.
    // No standalone XNU kernel handoff/ADT is bootable from this file yet.
};
