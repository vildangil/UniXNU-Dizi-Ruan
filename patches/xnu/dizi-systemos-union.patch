+/*
+ * dizi bring-up: mount the SystemOS volume read-only as a union over the read-only UFS root before
+ * launchd, so dyld finds its shared cache and libSystem. The build script allows this owner path only
+ * with verified block storage; dizi's ShengUfs answers the two volume queries itself when
+ * native-ufs-allow-unverified=1 is set and refuses otherwise, so the mount fails closed. The boot manifest
+ * hash that mount(8) needs is published from the same queries (IOKitBSDInit.cpp).
+ */
+#undef XNU_OWNER_CACHE_MOUNT
+#define XNU_OWNER_CACHE_MOUNT 1
+#undef XNU_OWNER_CACHE_STARTUP
+#define XNU_OWNER_CACHE_STARTUP 1
+#undef XNU_OWNER_UNION_SYSTEMOS
+#define XNU_OWNER_UNION_SYSTEMOS 1
+#undef XNU_OWNER_CRYPTEX_FILES
+#define XNU_OWNER_CRYPTEX_FILES 0
+#undef XNU_OWNER_BOOT_MANIFEST
+#define XNU_OWNER_BOOT_MANIFEST 1
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 #if !DEVELOPMENT && !DEBUG
 #error The offline owner cache mount is a development instrument
--- a/iokit/bsddev/IOKitBSDInit.cpp
