+				    allow_unverified == 1 && (vfs_flags(vnode_mount(rootvnode)) & MNT_RDONLY)) {
+					printf("rootvp not authenticated (error %d): accepted read-only for UFS bring-up\n", autherr);
+				} else {
+					panic("rootvp not authenticated after mounting");
+				}
 			}
